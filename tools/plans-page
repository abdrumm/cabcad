def page(plan: dict, ideas: list[dict], sources: list[Path]) -> str:
    q_ideas = [i for i in ideas if i["status"] == "OPEN QUESTION"]
    questions = [inline(q) for q in plan["questions"]] + [
        f'{inline(i["text"])} <span class="meta">· {html.escape(i["group"])}</span>' for i in q_ideas]
    count = {s: sum(1 for i in ideas if i["status"] == s) for s in STATUSES}
    count["OPEN QUESTION"] = len(questions)
    out = [f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
           f'<meta name="viewport" content="width=device-width,initial-scale=1">'
           f'<title>CabCad plans</title><style>{CSS}</style></head><body><main>',
           f'<header><h1>Cab<span>Cad</span> plans</h1>'
           f'<div class="meta">Plan updated {html.escape(plan["updated"] or "–")} · '
           f'page built {datetime.now():%b %d, %Y %H:%M}</div></header>',
           '<div class="counts">'
           + "".join(f'<div class="{"o" if s == "OPEN QUESTION" else ""}"><b>{count[s]}</b>{s.title()}</div>'
                     for s in STATUSES) + '</div>']
    if questions:
        out.append('<h2>Open questions</h2><ul class="questions">'
                   + "".join(f"<li>{q}</li>" for q in questions) + "</ul>")
    if plan["build"]:
        out.append('<h2>Build order</h2><table><tr><th></th><th>Step</th><th>Done when</th><th>Status</th></tr>')
        for r in plan["build"]:
            out.append(f'<tr><td class="n">{inline(r.get("#", ""))}</td><td>{inline(r.get("step", ""))}</td>'
                       f'<td>{inline(r.get("done when", ""))}</td><td class="s">{badge(r.get("status", ""))}</td></tr>')
        out.append("</table>")
    if plan["steps"]:
        out.append('<h2>Next concrete steps</h2><ul class="steps">'
                   + "".join(f"<li>{inline(s)}</li>" for s in plan["steps"]) + "</ul>")
    order = {s: n for n, s in enumerate(STATUSES)}
    rest = [i for i in ideas if i["status"] != "OPEN QUESTION"]
    if rest:
        out.append('<h2>Features and ideas</h2><table><tr><th>Status</th><th>Item</th><th>Area</th></tr>')
        for i in sorted(rest, key=lambda i: order[i["status"]]):
            test = f'<span class="test">{inline(i["test"])}</span>' if i["test"] else ""
            out.append(f'<tr><td class="s">{badge(i["status"])}</td><td>{inline(i["text"])}{test}</td>'
                       f'<td class="g">{html.escape(i["group"])}</td></tr>')
        out.append("</table>")
    if plan["prose"]:
        out.append("<h2>Plan details</h2>")
        for title, items in plan["prose"]:
            if items:
                out.append(f"<details><summary>{inline(title)}</summary><ul>"
                           + "".join(f"<li>{inline(b)}</li>" for b in items) + "</ul></details>")
    out.append('<footer>Generated by <code>tools/plans-page</code> from '
               + ", ".join(f"<code>{html.escape(str(p))}</code>" for p in sources)
               + ". Edit the markdown, not this page.</footer></main></body></html>")
    return "\n".join(out)


def build(plan_path: Path, ideas_path: Path, out_path: Path) -> Path:
    plan = parse_plan(plan_path.read_text(encoding="utf-8")) if plan_path.is_file() else parse_plan("")
    ideas = parse_ideas(ideas_path.read_text(encoding="utf-8")) if ideas_path.is_file() else []
    out_path.write_text(page(plan, ideas, [plan_path, ideas_path]), encoding="utf-8")
    return out_path


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--plan", type=Path, default=WORK / "CABCAD-PLAN.md")
    ap.add_argument("--ideas", type=Path, default=WORK / "CABCAD-IDEAS.md")
    ap.add_argument("--out", type=Path, default=WORK / "CABCAD-PLANS.html")
    a = ap.parse_args(argv)
    print(build(a.plan, a.ideas, a.out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
