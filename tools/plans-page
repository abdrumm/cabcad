#!/usr/bin/env python3
"""plans-page: CABCAD-PLAN.md + CABCAD-IDEAS.md -> one quiet HTML dashboard.

    tools/plans-page                       # writes ~/Work/CABCAD-PLANS.html
    tools/plans-page --out x.html --plan P.md --ideas I.md

Reads, never edits, the two docs. Conventions it understands:
  IDEAS:  "- BUILT — text"  (also NEXT, LATER, OPEN QUESTION; DONE counts as BUILT,
          NOW as NEXT), optionally followed by an indented "- Test: how to test" line.
  PLAN:   the "Build order" table (a Status column if present), "Open items" and
          "Open questions" sections (each bullet is an open question), "Next concrete steps".
Stdlib only.
"""
from __future__ import annotations

import argparse
import html
import re
import sys
from datetime import datetime
from pathlib import Path

WORK = Path.home() / "Work"
STATUSES = ("BUILT", "NEXT", "LATER", "OPEN QUESTION")
ALIASES = {"DONE": "BUILT", "NOW": "NEXT", "OPEN": "OPEN QUESTION", "QUESTION": "OPEN QUESTION"}
ITEM = re.compile(r"^- (BUILT|DONE|NOW|NEXT|LATER|OPEN QUESTION|OPEN|QUESTION)\s*[—–-]+\s*(.+)$")
TEST = re.compile(r"^\s+- (?:Test|How to test)\s*:\s*(.+)$", re.I)


def inline(text: str) -> str:
    out = html.escape(text, quote=False)
    out = re.sub(r"`([^`]+)`", r"<code>\1</code>", out)
    out = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", out)
    out = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<i>\1</i>", out)
    return out


def sections(md: str) -> list[tuple[str, list[str]]]:
    out, title, lines = [], "", []
    for line in md.splitlines():
        if line.startswith("## ") or line.startswith("### "):
            out.append((title, lines))
            title, lines = line.lstrip("# ").strip(), []
        else:
            lines.append(line)
    out.append((title, lines))
    return out


def parse_ideas(md: str) -> list[dict]:
    items, group = [], ""
    for title, lines in sections(md):
        group = title or group
        for line in lines:
            m = ITEM.match(line)
            if m:
                status = ALIASES.get(m.group(1), m.group(1))
                items.append({"group": group, "status": status, "text": m.group(2).strip(), "test": ""})
                continue
            t = TEST.match(line)
            if t and items:
                items[-1]["test"] = t.group(1).strip()
    return items


def parse_table(lines: list[str]) -> list[dict]:
    rows = [l for l in lines if l.strip().startswith("|")]
    if len(rows) < 2:
        return []
    cells = lambda r: [c.strip() for c in r.strip().strip("|").split("|")]
    head = [h.lower() for h in cells(rows[0])]
    return [dict(zip(head, cells(r))) for r in rows[2:]]


def bullets(lines: list[str]) -> list[str]:
    out = []
    for line in lines:
        if re.match(r"^(- |\d+\. )", line):
            out.append(re.sub(r"^(- |\d+\. )", "", line).strip())
        elif line.startswith("  ") and out and line.strip():
            out[-1] += " " + line.strip()
    return out


def parse_plan(md: str) -> dict:
    plan = {"title": "CabCad plan", "updated": "", "build": [], "questions": [], "steps": [], "prose": []}
    first = md.splitlines()[0] if md else ""
    if first.startswith("# "):
        plan["title"] = first[2:].strip()
    m = re.search(r"Updated ([0-9-]+[^.\n]*)", md)
    plan["updated"] = m.group(1) if m else ""
    for title, lines in sections(md):
        low = title.lower()
        if low.startswith("build order"):
            plan["build"] = parse_table(lines)
        elif low.startswith("open"):
            plan["questions"] += bullets(lines)
        elif low.startswith("next concrete"):
            plan["steps"] = bullets(lines)
        elif title and not low.startswith(("goal", "who gets")):
            plan["prose"].append((title, bullets(lines)))
    return plan


def badge(status: str) -> str:
    s = (status or "").upper().strip()
    s = ALIASES.get(s, s)
    cls = {"BUILT": "built", "NEXT": "next", "LATER": "later", "OPEN QUESTION": "open"}.get(s, "later")
    return f'<span class="st {cls}">{html.escape(s.title() if s else "–")}</span>'


